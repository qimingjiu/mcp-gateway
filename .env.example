# ========== 必填（没有就跑不起来） ==========
PORT=10000
# 管理接口密码，自己编一串长的，别外传
API_SECRET=

# 主对话模型（任何 OpenAI 兼容服务都行）
# Moonshot: https://api.moonshot.cn/v1
# DeepSeek: https://api.deepseek.com/v1
# 硅基流动: https://api.siliconflow.cn/v1
CHAT_API_KEY=
CHAT_BASE_URL=
CHAT_MODEL_NAME=

# ========== 推荐（记忆/画像/提醒都要靠它） ==========
# https://supabase.com 免费注册，Settings -> API 里拿
SUPABASE_URL=
SUPABASE_KEY=

# ========== 可选：Telegram 推送（AI 主动给你发消息） ==========
# 找 @BotFather 发 /newbot 拿 token
TG_BOT_TOKEN=
TG_CHAT_ID=

# ========== 可选：QQ 机器人（NapCat） ==========
NAPCAT_WS_URL=
NAPCAT_BOT_QQ=
NAPCAT_TARGET_USER=

# ========== 可选：AI 人设 ==========
AI_PERSONA=你是一个通用智能助手。
USER_NAME=
AI_NAME=

# 其余全部变量见 VARIABLES.md，用到再填
